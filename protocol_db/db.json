  "devices": {
    "046D:C54D": {
      "brand": "Logitech",
      "product": "USB Receiver",
      "type": "接收器",
      "note": "Unifying 兼容接收器。FF00:0001=HID++短报文收发（ping 已真机验证），FF00:0002=长报文输入通道（实测只进不出）",
      "source": "hidapi-observed + Solaar(lib/logitech_receiver/base.py) ping 布局",
      "verified": true,
      "protocol": {
        "name": "hidpp",
        "transport": {
          "match": {
            "usage_page": "FF00",
            "usage": "0001"
          },
          "short_len": 7,
          "long_len": 20,
          "response_timeout_ms": 600
        },
        "features": [
          {
            "id": "ping",
            "label": "HID++ Ping（探测设备在线 + 协议版本，只读安全）",
            "kind": "command",
            "report": "output",
            "template": [
              16,
              "{device_index}",
              0,
              "{request_id}",
              0,
              0,
              "{mark}"
            ],
            "params": {
              "device_index": {
                "type": "int",
                "default": 255,
                "min": 0,
                "max": 255,
                "label": "设备索引（0xFF=接收器自身）"
              },
              "request_id": {
                "type": "int",
                "default": 16,
                "min": 16,
                "max": 23,
                "label": "请求 ID（0x10-0x17）"
              },
              "mark": {
                "type": "int",
                "default": 66,
                "min": 0,
                "max": 255,
                "label": "随机标记字节（响应需一致）"
              }
            },
            "response": {
              "min_len": 7,
              "check": [
                16,
                "{device_index}",
                0,
                "{request_id}",
                null,
                null,
                "{mark}"
              ],
              "extract": {
                "major": 4,
                "minor": 5
              },
              "alt": {
                "label": "HID++ 错误应答（0x8F：1.0 设备或无设备在线）",
                "check": [
                  16,
                  "{device_index}",
                  143,
                  null,
                  null,
                  null,
                  null
                ],
                "extract": {
                  "error_code": 5
                }
              }
            }
          }
        ]
      }
    },
