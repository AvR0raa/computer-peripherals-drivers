  "pending_brands": [
    { "name": "MAGEGEE", "name_zh": "美嘉獅",
      "note": "无公开VID，常见为OEM芯片方案(Holtek 04D9/Sonix等)。插上设备跑 cli.py list 或 GUI 实测 VID:PID 后移入 brands。" }
  ],

  "devices": {
    "046D:C54D": {
      "brand": "Logitech",
      "product": "USB Receiver",
      "note": "Unifying 兼容接收器。FF00:0001=HID++短报文收发（ping 已真机验证），FF00:0002=长报文输入通道（实测只进不出）",
      "source": "hidapi-observed + Solaar(lib/logitech_receiver/base.py) ping 布局",
      "verified": true,
      "protocol": {
        "name": "hidpp",
        "transport": {
          "match": { "usage_page": "FF00", "usage": "0001" },
          "short_len": 7,
          "long_len": 20,
          "response_timeout_ms": 600
        },
        "features": [
          {
            "id": "ping",
            "label": "HID++ Ping（探测设备在线 + 协议版本，只读安全）",
            "kind": "command",
            "report": "output",
            "template": [16, "{device_index}", 0, "{request_id}", 0, 0, "{mark}"],
            "params": {
              "device_index": { "type": "int", "default": 255, "min": 0, "max": 255, "label": "设备索引（0xFF=接收器自身）" },
              "request_id": { "type": "int", "default": 16, "min": 16, "max": 23, "label": "请求 ID（0x10-0x17）" },
              "mark": { "type": "int", "default": 66, "min": 0, "max": 255, "label": "随机标记字节（响应需一致）" }
            },
            "response": {
              "min_len": 7,
              "check": [16, "{device_index}", 0, "{request_id}", null, null, "{mark}"],
              "extract": { "major": 4, "minor": 5 },
              "alt": {
                "label": "HID++ 错误应答（0x8F：1.0 设备或无设备在线）",
                "check": [16, "{device_index}", 143, null, null, null, null],
                "extract": { "error_code": 5 }
              }
            }
          }
        ]
      }
    },
    "291D:385D": {
      "brand": "MCHOSE",
      "product": "MCHOSE V9 PRO",
      "note": "游戏鼠标；接口0 复用 6 个 usage page，vendor 页 0xFF21(feature id=237,15字节)/0xFF22(feature id=170,63字节)/0xFF90/0xFF82，疑似配置通道",
      "source": "hidapi-observed",
      "verified": false
    },
    "41E4:2116": {
      "brand": "MCHOSE",
      "product": "Ace68-II",
      "note": "磁轴游戏键盘（Ace 68 系列）。接口1(usage=0x0000, 64字节in/out)=rawhid风格配置通道，写入协议待 M4 学习模式逆向",
      "source": "hidapi-observed",
      "verified": false
    }
  }
}
